# NocoDB connection
NOCODB_URL=http://localhost:8080
NOCODB_API_KEY=nc_pat_your_api_key_here
NOCODB_BASE_ID=p_your_base_id_here

# NocoDB table IDs (find these in NocoDB URL when viewing the table)
NOCODB_WATCHLIST_TABLE_ID=md_xxxxxxxxxxxx
NOCODB_MATCHES_TABLE_ID=md_xxxxxxxxxxxx
NOCODB_STATE_TABLE_ID=md_xxxxxxxxxxxx

# Warez.cx API base URL
WAREZ_API_BASE=https://api.warez.cx

# Optional: extra headers for warez API (if reverse engineering requires them)
# WAREZ_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
# WAREZ_COOKIE=

# Scraper behaviour
# Maximum pages to scan per incremental run (safety cap, 0 = unlimited)
MAX_INCREMENTAL_PAGES=20
# Delay between search queries in milliseconds (rate limiting)
SEARCH_DELAY_MS=1500
# Minimum quality to accept (720p, 1080p, 2160p, or empty for any)
DEFAULT_QUALITY_MIN=
